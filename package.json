{
  "name": "ts-migrate-runtime",
  "version": "0.1.0",
  "description": "Migrate a JavaScript/TypeScript project between package managers (npm, pnpm, yarn, bun).",
  "module": "src/index.ts",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "ts-migrate-runtime": "./dist/index.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nazozokc/ts-migrate-runtime.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outfile dist/index.mjs --target node",
    "typecheck": "bun check",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "yaml": "^2.9.1"
  }
}
