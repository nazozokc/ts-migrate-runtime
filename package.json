{
  "name": "ts-migrate-runtime",
  "version": "0.1.0",
  "description": "Migrate a JavaScript/TypeScript project between package managers (npm, pnpm, yarn, bun).",
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "ts-migrate-runtime": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outfile dist/index.mjs --target bun",
    "typecheck": "bun check",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  }
}
